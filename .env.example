# Copy to .env and fill in. Never commit .env.
# Orbit views (/orbit) uses these if the form API key field is blank.

# Gemini image models (gemini-2.5-flash-image)
GEMINI_API_KEY=

# Optional alias if you already use a Google AI Studio key
# GOOGLE_API_KEY=

# OpenAI image models (gpt-image-1)
OPENAI_API_KEY=

# Optional: Hugging Face token for gated/private weights
# HF_TOKEN=
